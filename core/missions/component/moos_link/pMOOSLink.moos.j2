{%- set link = component.moos_link %}
ProcessConfig = pMOOSLink
{
  AppTick   = 4
  CommsTick = 4
  remote_server = localhost
  remote_port   = {{ link.remote_port }}
{%- for var in link.inputs %}
  in  = {{ var }}
{%- endfor %}
{%- for var in link.outputs %}
  out = {{ var }}
{%- endfor %}
}
