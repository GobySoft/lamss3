//
// Bearing detector and tracker on pLamssCBF's BEAM_DATA and pLamssAEL's AEL_NAV, as the mbat
// missions configure it; publishes BEARING_TRACKS, DETECTOR_STAT, IPS and STAB_AZ.

ServerHost = localhost
ServerPort = 9000
Community  = sonar
LatOrigin  = 42.358
LongOrigin = -71.087

ProcessConfig = pLamssBearingTracker
{
  common { app_tick: 4 comm_tick: 4 }

  ael_nav_variable: "AEL_NAV"
  alpha: 0.075
  dep_angle: 0.0
  lr_beams: 7
  alpha_head: 0.075
  turn_rate_threshold: 0.1
  beam_changed_threshold: 11
  max_ubias_iter: 25
  abs_uerror_threshold: 1.0
  theta_min: 30.0
  detection_count_threshold: 5
  detector_type: 2
  detector_number_bins: 15
  detector_first_noise_bin: 10
  detector_alpha: 0.9
  noise_depth: 5.0
  detection_threshold: 20.0
}
