{%- set sim = component.passive_sonar_sim %}
ProcessConfig = uSimTowedArray
{
  AppTick   = 4
  CommsTick = 5
  cond_check       = 1
  start_speed      = 0.5
  create_dir_frame = 0
  write_out_files  = 0
  filter_length    = 40
  array_type  = towed
  tow_point_x = {{ sim.tow_point.x }}
  tow_point_y = {{ sim.tow_point.y }}
  tow_point_z = {{ sim.tow_point.z }}
  number_sectors = 3
  sector_1 = 20, 20.0, .0000, .0095, .001, 0.1, 1.0e8
  sector_2 = 30, 36.0, .0000, .035, .0024, 0.5, 1.0e8
  sector_3 = 20, 20.0, .0000, .0095, .001, 0.1, 1.0e8
  tow_body = 0
  towbody_parameters = 0.0, 0.0, 0.0
  array_section_number = 2
  first_phone_offset   = 3.0
  array_definition_type = 1
  phone_spacing_groups  = {{ sim.spacing_groups | length }}
{%- for group in sim.spacing_groups %}
  spacing_group_{{ loop.index }}      = {{ group.spacing }}
  num_spacings_group_{{ loop.index }} = {{ group.count }}
{%- endfor %}
}
