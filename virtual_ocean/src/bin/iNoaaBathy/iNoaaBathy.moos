//------------------------------------------------------------------
// iNoaaBathy configuration  block

ProcessConfig = iNoaaBathy
{
  // available to all moos processes.
  AppTick    = 4
  CommsTick  = 4

  // all case insensitive
  nc_bathy_file = ~/missions-lamss/cruise/current/data/nc_bathy_file.nc
 
  // number of seconds between publishes of mseas bathy data
  publish_interval = 5;
}
