{%- set fs = component.frontseat %}
ProcessConfig = iFrontSeat
{
  common { app_tick: 20 }
  frontseat_cfg {
    require_helm: true
    helm_running_timeout: 10
    frontseat_connected_timeout: 10
    status_period: 5
    exit_on_error: false
    [goby.middleware.frontseat.protobuf.bluefin_config] {
      huxley_tcp_address: {{ fs.huxley_address | pb_string }}
      huxley_tcp_port: {{ fs.huxley_port }}
      extra_bplog: "CMA"
      extra_bplog: "CPS"
      extra_bplog: "CPR"
      accepting_commands_hook: BFMSC_TRIGGER
    }
  }
  moos_var {
    prefix: "IFS_"
    data_from_frontseat: "DATA_IN"
    data_to_frontseat: "DATA_OUT"
  }
  legacy_cfg {
    subscribe_desired: true
    subscribe_ctd: true
    subscribe_acomms_raw: true
    pub_sub_bf_commands: true
    publish_nav: true
    publish_fs_bs_ready: true
  }
}
