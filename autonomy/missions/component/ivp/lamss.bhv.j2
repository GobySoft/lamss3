}
Behavior = BHV_ConstantSpeed
{
  name      = track_speed
  speed     = 2.5
  duration  = no-time-limit
  condition = (MODE == ADAPTIVE)
  condition = ACTIVE_TRACK_TRAIL != TRUE
}
Behavior = BHV_MaintainBearing
{
  name = track_array_angle
  pwt  = 100
  width = 60
  heading_variable = AEL_HEADING
  bearing_variable = BEARING_STAT
  desired_angle = 45
  bearing_mode  = dual
  alternate_interval = 450
  bearing_rate_threshold = 3.0
  updates       = ARRAY_TRACK_ANGLE
  condition = (MODE == ADAPTIVE)
  condition = ACTIVE_TRACK_TRAIL != TRUE
