  inactiveflag =   TRACKING_BEARING_ADAPT = FALSE
}
Behavior = BHV_Trail
{
  name = track_trail
  contact =          {{ topside | upper }}
  trail_range =      300
  trail_angle =      315
  trail_angle_type = absolute
  radius = 5
  nm_radius = 20
  pwt_outer_dist = 200
  extrapolate = true
  decay = 60,120
  updates   =      TRACK_TRAIL_CONFIG
  condition =      (MODE == ADAPTIVE)
  condition =      TRACKING_LOCK = TRUE
  runflag   =      TRACK_TRAIL = TRUE
  idleflag   =     TRACK_TRAIL = FALSE
  activeflag =     ACTIVE_TRACK_TRAIL = TRUE
  inactiveflag =   ACTIVE_TRACK_TRAIL = FALSE
}
Behavior = BHV_OpRegion
{
  polygon      = label,SafeOpBox: {{ cruise.op_box | map('join', ',') | join(':') }}
  name         = bhv_op_region
  max_depth    = 100
  max_time     = 0
  trigger_entry_time = 1.0
  trigger_exit_time  = 1.0
}
 Behavior = {{ component.ivp.avoid_obstacle }}
 {
   name = avd_obstacle
   pwt           = 200
   duration	= no-time-limit
   polygon      = format=ellipse,x={{ cruise.gateway_buoy.x }},y={{ cruise.gateway_buoy.y }},degs=0,pts=8,major=40,minor=20
   updates = OBSTACLE_ALERT
   condition = (MODE == DIVING)
   templating =  spawn
    allowable_ttc = 30
   pwt_outer_dist = 100
   pwt_inner_dist = 40
   completed_dist = 150
 }
Behavior = BHV_AvoidCollision
{
  name       = bhv_avd_ship
  pwt        = 200
  condition = (MODE == DIVING)
  endflag   = CONTACT_RESOLVED = $[CONTACT]
                updates = CONTACT_INFO_ship
             templating = spawn
                contact = {{ topside }}
           pwt_grade = linear
         completed_dist = 100
  	 pwt_outer_dist = 80
  	 pwt_inner_dist = 30
      min_util_cpa_dist = 0
        collision_depth = 20
                  decay = 90,180
}
Behavior = BHV_MinAltitude
{
  name = min_altitude
  pwt = 1000
  min_altitude  = 6.0
  condition = (MODE == DIVING)
  condition = (MODE != MISSION:DIVING:DEPLOY:LANDING:TOUCHDOWN)
  condition = (MODE != MISSION:DIVING:DEPLOY:LANDING:BOTTOMING)
}
Behavior = BHV_MaxDepth
{
  name = max_auv_depth
  pwt = 1000
  max_depth  = 600
  condition = (MODE == DIVING)
}
Behavior = BHV_ConstantSpeed
{
  name          = diving_at_speed
  pwt           = 200
  speed         = 2.5
  duration	= no-time-limit
  condition     = NAV_DEPTH < 2.0
  condition     = DESIRED_DEPTH  > 2.0
  condition     = (MISSION_STATE != IDLE)
}
Behavior = BHV_MemoryTurnLimit
{
  name = turn_limit
  pwt = 600
  memory_time = 30
  turn_range  = 45
  condition = (MODE == MISSION)
}
 Behavior = BHV_PeriodicSurface
{
  name            = surface_for_gps
  pwt = 500
  period          = 1800
  speed_to_surface = 1.5
  zero_speed_depth = 1
  pending_status_var = PENDING_SURFACE
  ascent_grade  = fullspeed
  max_time_at_surface = 30
  mark_variable   = GPS_UPDATE_RECEIVED
  updates         = GPS_CONFIGURATION
  condition       = MISSION_STATE != PROSECUTE
  condition       = (DEPLOY_MISSION != RACETRACK) or (((DEPLOY_MISSION = RACETRACK) and (IN_TRACK = FALSE)) or (ALREADY_STARTED = true))
  activeflag = ALREADY_STARTED = true
  inactiveflag = ALREADY_STARTED = false
}
Behavior = BHV_MaintainHeading
{
  name       = maintain_heading
  pwt        = 400
  condition  = (DEPLOY_MISSION = RACETRACK) and (PERIODIC_ASCEND = true)
  nostarve   = PERIODIC_ASCEND, 30
  duration   = 600
         heading = on_active
       peakwidth = 20
       basewidth = 160
     summitdelta = 95
}
