{%- set topside = component.mission_manager.topside %}
initialize  VEHICLE_ID        = {{ platform.modem_id }}
initialize  COLLABORATOR_NAME = {{ topside | upper }}
initialize  COLLABORATOR_ID   = {{ platforms[topside].modem_id }}
initialize  DEPLOY_RADIUS     = {{ component.mission_manager.operation_radius }}
initialize  BACKSEAT_READY = 1
initialize_  GOTO_SURFACE = FALSE
initialize_  MISSION_STATE = FALSE
initialize  GPS_UPDATE_RECEIVED = Null
initialize  ALREADY_STARTED= false
initialize   SURVEY_START  = 0.0
initialize  IN_TRACK = TRUE
initialize  IVP_MANUAL_OVERIDE = FALSE
initialize  DEPLOY_DEPTH_ADAPT = FALSE
set MODE = ALLSTOP {
MISSION_STATE = ALLSTOP
} MISSION
set MODE = MANUAL {
MODE = ALLSTOP
IVP_MANUAL_OVERIDE = TRUE
}
set MODE = SURFACING {
MODE = MISSION
GOTO_SURFACE = TRUE
} DIVING
set MODE = DEPLOY {
MODE = MISSION:DIVING
MISSION_STATE = DEPLOY
}
set MODE = PROSECUTE {
MODE = MISSION:DIVING
MISSION_STATE = PROSECUTE
}
set MODE = DRIFTING {
MODE = MISSION:DIVING
MISSION_STATE = DRIFTING
}
set MODE = ABORT {
MODE = MISSION:DIVING
MISSION_STATE = ABORT
}
set MODE = TRANSIT {
MODE = MISSION:DIVING:DEPLOY
MISSION_STATE = DEPLOY
TRANSIT_MODE = ROUTE
}
set MODE = LOITER {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = LOITER
}
set MODE = RETURN {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = RETURN
}
set MODE = RECOVERY {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = RECOVERY
}
set MODE = STATION_KEEP {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = STATION_KEEP
}
set MODE = RACETRACK{
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = RACETRACK
}
set MODE = ZIGZAG {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = ZIGZAG
}
set MODE = LAWNMOWER {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = LAWNMOWER
}
set MODE = TRAIL {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = TRAIL
}
set MODE = PATHFOLLOW {
MODE =MISSION:DIVING:DEPLOY
DEPLOY_MISSION=PATHFOLLOW
}
set MODE = SAMPLETARFIELD{
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION=SAMPLETARFIELD
}
set MODE = SPIRAL {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = SPIRAL
}
set MODE = TRACK_FRONT {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = TRACK_FRONT
}
set MODE = FOLLOWSOURCE {
MODE= MISSION:DIVING:DEPLOY
DEPLOY_MISSION=FOLLOWSOURCE
}
set MODE = LANDING {
MODE = MISSION:DIVING:DEPLOY
DEPLOY_MISSION = LANDING
}
set MODE = DESCENT {
MODE = MISSION:DIVING:DEPLOY:LANDING
LANDING_STATE = DESCENT
}
set MODE = TOUCHDOWN {
MODE = MISSION:DIVING:DEPLOY:LANDING
LANDING_STATE = TOUCHDOWN
}
set MODE = BOTTOMING {
MODE = MISSION:DIVING:DEPLOY:LANDING
LANDING_STATE = BOTTOMING
}
set MODE = LIFTOFF {
MODE = MISSION:DIVING:DEPLOY:LANDING
LANDING_STATE = LIFTOFF
}
set MODE = SEARCHING {
MODE = MISSION:DIVING:PROSECUTE
TRACKING = NO_TRACK
}
set MODE = AMBIGUOUS {
MODE = MISSION:DIVING:PROSECUTE
TRACKING = AMBIGUOUS
}
set MODE = TRACKING {
MODE = MISSION:DIVING:PROSECUTE
TRACKING = TRACKING
}
set MODE = CLASSIFYING {
MODE = MISSION:DIVING:PROSECUTE
TRACKING = CLASSIFYING
}
set MODE = ADAPTIVE {
MODE =  MISSION:DIVING:PROSECUTE:TRACKING
PROSECUTE_MISSION = ADAPTIVE
}
set MODE = MULTIPLE {
MODE =  MISSION:DIVING:PROSECUTE:TRACKING:ADAPTIVE
(COLLABORATION_MODE = COLLABORATING) and (CLOSE_RANGE = TRUE)
} SINGLE
set MODE = TMA {
MODE = MISSION:DIVING:PROSECUTE:TRACKING
PROSECUTE_MISSION = TMA_ZIGZAG
}
set MODE = HEX {
MODE = MISSION:DIVING:PROSECUTE:TRACKING
PROSECUTE_MISSION = POLYGON
}
Behavior = BHV_GoToDepth
{
  name          = surface_depth
  pwt           = 100
   depth = 0.5
  arrival_delta = 1
  perpetual 	= true
  condition = (MODE == SURFACING)
  endflag       = MISSION_STATE = ALLSTOP
  endflag       = GOTO_SURFACE = FALSE
  endflag       = SONAR_CONTROL = OFF
}
Behavior = BHV_ConstantSpeed
{
  name          = surface_speed
  pwt           = 100
   speed        = 1.0
  duration	= no-time-limit
  condition     = (MODE == SURFACING)
}
Behavior = BHV_Waypoint
{
  name      = return_to_waypoint
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  updates   = DEPLOY_STATION
  duration  = no-time-limit
  perpetual = true
  condition = (MODE == RETURN) or (MODE == RECOVERY)
  condition = (USBL_ENABLED = FALSE)
  endflag   = GOTO_SURFACE = TRUE
  endflag   = SONAR_MODE = OFF
}
Behavior = BHV_Loiter
{
  name      = return_homing_loiter
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  updates   = HOMING_CONFIG
  duration  = no-time-limit
  clockwise = false
  acquire_dist = 10
  condition = (MODE == RETURN)
  condition = (USBL_ENABLED = TRUE)
  polygon = format=radial, x=50 , y=50 , radius=50, pts=8, snap=1, label=Homing
}
Behavior = BHV_Waypoint
{
  name      = home_on_beacon
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  updates   = HOMING_STATION
  duration  = no-time-limit
  perpetual = true
  condition = (MODE == RECOVERY)
  condition = (USBL_ENABLED = TRUE)
  endflag   = GOTO_SURFACE = TRUE
  endflag   = SONAR_MODE = OFF
}
Behavior = BHV_ConstantDepth
{
  name      = allstop_depth
  depth = 0
  duration  = no-time-limit
  condition = (MODE == ALLSTOP)
}
Behavior = BHV_ConstantSpeed
{
  name      = allstop_speed
  speed = 0
  duration  = no-time-limit
  condition = (MODE == ALLSTOP)
}
Behavior = BHV_Waypoint
{
  name      = transit_path
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  points    = 0,0
  updates   = TRANSIT_ROUTE
  duration  = no-time-limit
  perpetual = true
  wpt_index_var = TRANSIT_WPT_INDEX
  condition = (MODE == TRANSIT)
  inactiveflag  = TRANSIT_COMPLETED = TRUE
  activeflag  = TRANSIT_COMPLETED = FALSE
}
Behavior = BHV_ConstantDepth
{
  name      = transit_depth
  depth     = 10
  updates   = TRANSIT_DEPTH
  duration  = no-time-limit
  condition = (MODE == TRANSIT)
}
Behavior = BHV_StationKeep
{
  name      = bhv_station_keep
  pwt       = 200
  condition = MODE == STATION_KEEP
  condition = AT_STATION_DEPTH = true
  updates = DEPLOY_STATION
  center_activate = false
  inner_radius = 20
  outer_radius = 40
  hibernation_radius = 150
  outer_speed = 1.6
  transit_speed = 1.6
  runflag = STATION_KEEPING = true
  idleflag = STATION_KEEPING = false
  activeflag = ON_STATION = false
  inactiveflag = ON_STATION = true
}
Behavior = BHV_Loiter
{
  name      = bhv_station_depth_loiter
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  updates   = SENSOR_DEPLOY
  duration  = no-time-limit
  clockwise = false
  acquire_dist = 10
  condition = MODE == STATION_KEEP
  condition = (DEPTH_MISMATCH > 5) or ((DEPTH_MISMATCH > 1) and ((AT_STATION_DEPTH = false) and (STATION_KEEPING = false) ))
  runflag = AT_STATION_DEPTH = false
  idleflag = AT_STATION_DEPTH = true
}
Behavior = BHV_RaceTrack
{
  name      = deploy_racetrack
  track_length = 400
  track_width  = 200
  distance_tolerance  = 10
  approach_angle = 60
  heading        = 270
  speed          = 1.6
  peak_width     = 30
  summit_delta   = 50
  points = 500.0, 200.0
  clockwise = true
  updates = SENSOR_RACETRACK
  duration  = no-time-limit
  condition = (MODE == RACETRACK)
  idleflag = IN_TRACK = TRUE
  inactiveflag = IN_TRACK = TRUE
}
Behavior = BHV_ConstantDepth
{
  name      = rtrk_depth_out
  depth = 15
  duration  = no-time-limit
  updates = SENSOR_DEPTH_DEPLOY
  condition = ((MODE == RACETRACK) and (DEPTH_MODE = DUAL))
  condition = (RACETRACK_LEG >= 0)
}
Behavior = BHV_ConstantDepth
{
  name      = rtrk_depth_in
  depth = 45
  duration  = no-time-limit
  updates = SENSOR_DEPTH_ALTERNATE
  condition = (MODE == RACETRACK) and (DEPTH_MODE = DUAL)
  condition = (RACETRACK_LEG < 0)
}
Behavior = BHV_SmartYoyo
{
  name      = rtrk_yoyo
  updates = SMART_YOYO
  min_depth =       2
  max_depth =       20
  min_altitude =    5
  period =          300
  period_segments = 50
  depth_function = sinusoidal
  duration  = no-time-limit
  condition = (MODE == RACETRACK) and (DEPTH_MODE = YOYO)
  condition = (ON_TRACKLINE = TRUE)
}
Behavior = BHV_ConstantDepth
{
  name      = yoyo_approach_depth
  updates   = SENSOR_DEPTH_DEPLOY
  duration  = no-time-limit
  condition = (MODE == RACETRACK) and (DEPTH_MODE = YOYO)
  condition = (ON_TRACKLINE = FALSE)
}
Behavior = BHV_Loiter
{
  name      = deploy_loiter
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  updates   = SENSOR_DEPLOY
  duration  = no-time-limit
  clockwise = false
  acquire_dist = 10
  post_mapping = LOITER_INDEX
  condition = MODE == LOITER
}
Behavior = BHV_Waypoint
{
  name      = zigzag_survey
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  updates   = ZIGZAG_STATUS
  perpetual = true
  duration  = no-time-limit
  wpt_index_var = SURVEY_WPT_INDEX
  condition = (MODE == ZIGZAG)
  endflag   = SURVEY_COMPLETED = TRUE
}
Behavior = BHV_Waypoint
{
  name      = lawnmower_survey
  speed     = 1.6
  radius    = 5
  nm_radius = 10
    lead      = 10.0
  updates   = SURVEY_CONFIG
  perpetual = true
  duration  = no-time-limit
  wpt_index_var = SURVEY_WPT_INDEX
  condition = (MODE == LAWNMOWER)
  endflag   = SURVEY_COMPLETED = TRUE
}
Behavior = BHV_ConstantDepth
{
  name      = deploy_depth
  updates   = SENSOR_DEPTH_DEPLOY
  duration  = no-time-limit
  condition = (MODE == DIVING)
  condition = (MODE != MISSION:DIVING:DEPLOY:TRAIL)
  condition = (MODE != MISSION:DIVING:DEPLOY:SAMPLETARFIELD)
  condition = (MODE != MISSION:DIVING:DEPLOY:PATHFOLLOW)
  condition = (MODE != MISSION:DIVING:DEPLOY:TRANSIT)
  condition = (DEPTH_MODE = SINGLE)
}
Behavior = BHV_ConstantDepth
{
  name      = trail_loiter_depth
  updates   = SENSOR_DEPTH_ALTERNATE
  duration  = no-time-limit
  condition = (MODE == TRAIL) and (DEPTH_MODE = SINGLE)
  condition = (TRAILING = TRUE) and (ACTIVE_TRAIL = FALSE)
}
Behavior = BHV_ConstantDepth
{
  name      = trail_active_depth
  updates   = SENSOR_DEPTH_DEPLOY
  duration  = no-time-limit
  condition = (MODE == TRAIL) and (DEPTH_MODE = SINGLE)
  condition = (TRAILING = TRUE) and (ACTIVE_TRAIL = TRUE)
}
Behavior = BHV_ConstantDepth
{
  name      = sample_depth
  updates   = SAMPLE_DEPTH_DEPLOY
  duration  = no-time-limit
  condition = ((MODE == SAMPLETARFIELD) or (MODE == PATHFOLLOW))
}
Behavior = BHV_SmartYoyo
{
  name      = deploy_yoyo
  updates = SMART_YOYO
  min_depth       = 2
  max_depth       = 20
  min_altitude    = 5
  period          = 300
  period_segments = 60
  depth_function  = linear
  duration  = no-time-limit
  condition = (MODE == DEPLOY) and (DEPTH_MODE = YOYO)
  condition = (MODE != MISSION:DIVING:DEPLOY:RACETRACK)
}
Behavior = BHV_ConstantAltitude
{
  name      = bottom_following_depth
  altitude  = 5.0
  updates   = SENSOR_ALTITUDE
  duration  = no-time-limit
  condition = (MODE == DEPLOY) and (DEPTH_MODE = BOTTOM_FOLLOWING)
}
Behavior = BHV_ConstantBuoyancy
{
  name = neutral_buoyancy
  buoyancy = 0
  duration = no-time-limit
  condition = (MODE != MISSION:DIVING:DEPLOY:LANDING:TOUCHDOWN)
  condition = (MODE != MISSION:DIVING:DEPLOY:LANDING:BOTTOMING)
  condition = (MODE != MISSION:DIVING:DEPLOY:LANDING:LIFTOFF)
}
Behavior = BHV_Trail
{
  name = trail_collaborator
  contact =          {{ topside | upper }}
  trail_range =      300
  trail_angle =      315
  trail_angle_type = absolute
  radius = 10
  nm_radius = 50
  pwt_outer_dist = 2000
  extrapolate = true
  decay = 60,120
  updates   =      TRAIL_CONFIG
  condition =      (MODE == TRAIL)
  runflag   =      TRAILING = TRUE
  idleflag   =     TRAILING = FALSE
  activeflag =     ACTIVE_TRAIL = TRUE
  inactiveflag =   ACTIVE_TRAIL = FALSE
}
Behavior = BHV_Loiter
{
  name      = trail_idle_loiter
  pwt       =        100
  speed     =        1.6
  radius    =        50.0
  nm_radius =       100.0
  updates   =        SENSOR_DEPLOY
  center_activate =  true
  duration  =        no-time-limit
  clockwise =        false
  acquire_dist =     40
  condition = (MODE == TRAIL)
  condition = (ACTIVE_TRAIL = FALSE)
}
Behavior = BHV_OptAcommsDepth
{
  name      = opt_snr_depth
  duration  = no-time-limit
  updates            = ADAPTIVE_DEPTH
    contact            = {{ topside | upper }}
  look_ahead_seconds = 120
  calculate_interval = 17
  sonar              = passive
  depth_min          = 10
  depth_max          = 300
  number_depths      = 291
  theta_min          = -60
  theta_max          = 60
  number_theta       = 601
  depth_envelope     = 200
  depth_uncertainty  = 5
  departure_range    = 100
  approach_range     = 10000
  range_max          = 10000
  adapt_tl_threshold = 3.0
  optimize           = snr
  multipath_penalty  = 3
  bounce_penalty  = 3
  water_depth = 100
  surface_sound_speed = 1480.0
  sound_speed_gradient = 0.001;
   max_number_bounces = 4
  beam_width = 60
  condition = (MODE == DIVING)
  condition = (DEPTH_MODE = ADAPTIVE_ACOMMS)
  activeflag =     DEPLOY_DEPTH_ADAPT = TRUE
  inactiveflag =   DEPLOY_DEPTH_ADAPT = FALSE
}
Behavior = BHV_ConstantDepth
{
  name      = last_acomms_depth
  updates   = ACOMMS_DEPTH
  depth     = 20
  duration  = no-time-limit
  condition = (MODE == DIVING)
  condition = (DEPTH_MODE = ADAPTIVE_ACOMMS)
  condition = (DEPLOY_DEPTH_ADAPT = FALSE)
}
Behavior = BHV_Loiter
{
  name      = descent_loiter
  speed     = 1.6
  radius    = 10
  nm_radius = 20
  updates   = SENSOR_DEPLOY
  duration  = no-time-limit
  clockwise = false
  acquire_dist = 10
  post_mapping = LOITER_INDEX,DESCENT_WPT_INDEX
  condition = MODE == DESCENT
}
Behavior = BHV_ConstantBuoyancy
{
  name      = bottoming_buoyancy
  buoyancy = -5.0
  duration  = no-time-limit
  condition = (MODE == BOTTOMING) or (MODE == TOUCHDOWN)
}
Behavior = BHV_ConstantAltitude
{
  name      = bottoming_depth
  altitude  = 0.5
  duration  = no-time-limit
  condition = (MODE == BOTTOMING) or (MODE == TOUCHDOWN)
}
Behavior = BHV_ConstantSpeed
{
  name      = bottoming_speed
  speed = 0
  duration  = no-time-limit
  condition = (MODE == BOTTOMING) or (MODE == TOUCHDOWN)
}
Behavior = BHV_ConstantHeading
{
  name      = bottoming_heading
  updates   = TOUCHDOWN_HEADING
  duration  = no-time-limit
  condition = (MODE == BOTTOMING) or (MODE == TOUCHDOWN)
}
Behavior = BHV_ConstantBuoyancy
{
  name      = liftoff_buoyancy
  buoyancy = 5.0
  duration  = no-time-limit
  condition = (MODE == LIFTOFF)
}
Behavior = BHV_ConstantSpeed
{
  name      = search_speed
  speed     = 1.6
  duration  = no-time-limit
  priority  = 150
  condition = (MODE == SEARCHING)
}
  Behavior = BHV_Attractor
{
         name      = search_attract
         updates   = MY_TARGET
         priority  = 100
         duration  = no-time-limit
         condition = (MODE == SEARCHING)
         condition = PROSECUTE_MISSION != POLYGON
         condition = (IN_RANGE = FALSE)
         contact = TARGET_CUE
         dist_priority_interval = 1000,3000
         strength = 1.0
         decay = 600,1200
         patience = 0
         giveup_range = 5000
         activeflag =     ACTIVE_ATTRACT = TRUE
         inactiveflag =   ACTIVE_ATTRACT = FALSE
}
Behavior = BHV_Loiter
{
  name      = search_loiter
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  updates   = SENSOR_DEPLOY
  duration  = no-time-limit
  clockwise = false
  acquire_dist = 40
  condition = (MODE == SEARCHING)
  condition = (PROSECUTE_MISSION != POLYGON) and (ACTIVE_ATTRACT = FALSE)
}
Behavior = BHV_WiggleTail
{
  name = ambiguous_arrayturn
  turn_angle =        120
  pwt  = 700
  heading_variable =  AEL_HEADING
  bearing_variable =  BEARING_STAT
  condition = (MODE == AMBIGUOUS)
}
Behavior = BHV_ConstantSpeed
{
  name      = ambiguous_speed
  speed     = 1.6
  duration  = no-time-limit
  condition = (MODE == AMBIGUOUS)
}
 Behavior = BHV_ConstantDepth
{
  name      = drift_depth
  updates   = SENSOR_DEPTH_DEPLOY
  duration  = no-time-limit
  condition = (MODE == DRIFTING)
}
 Behavior = BHV_ConstantSpeed
{
  name      = drift_speed
  speed     = 0
  duration  = no-time-limit
  condition = (MODE == DRIFTING)
}
 Behavior = BHV_MaintainHeading
{
  name       = drift_heading
  pwt        = 100
  duration  = no-time-limit
  condition = (MODE == DRIFTING)
         heading = on_active
       peakwidth = 150
       basewidth = 300
     summitdelta = 50
}
Behavior = BHV_ConstantHeading
{
  name      = abort_heading
  updates   = ABORT_HEADING
  duration  = no-time-limit
  duration_reset = MISSION_STATE = ABORT
  perpetual = true
  condition = (MODE == ABORT)
  endflag   = GOTO_SURFACE = TRUE
  endflag   = SONAR_MODE = OFF
}
Behavior = BHV_ConstantSpeed
{
  name      = abort_speed
  updates   = ABORT_SPEED
  duration  = no-time-limit
  condition = (MODE == ABORT)
}
Behavior = BHV_LamssZigZag
{
  name      = tma_zigzag
  speed     = 1.6
  updates   = BROADSIDE_HEADING
  period    = 600
  amplitude = 100
  heading   = 135
  zigzag_function = linear
  duration  = no-time-limit
  condition = (MODE == TMA)
}
Behavior = BHV_Loiter
{
  name      = tracking_hex
  speed     = 1.6
  radius    = 5
  nm_radius = 10
  updates   = SENSOR_DEPLOY
  duration  = no-time-limit
  clockwise = false
  acquire_dist = 40
  condition = (MODE == SPIRAL_TRACKING)
}
 Behavior = BHV_RubberBand
{
         name      = track_rubberband
         updates   = DEPLOY_STATION
         priority  = 100
         duration  = no-time-limit
         condition = (MODE == ADAPTIVE)
         inner_radius = 1500
         outer_radius = 5000
         outer_speed  = 1.6
